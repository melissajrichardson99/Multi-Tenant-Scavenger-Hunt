# Copy to .env in the project root and fill in. The backend refuses to start
# if DATABASE_URL or JWT_SECRET_KEY is missing.

# development (default) | production. Production has no localhost defaults:
# CORS_ALLOWED_ORIGINS, PUBLIC_BASE_URL and Supabase Storage become required.
APP_ENV=development

# Local development: a SQLite file in the project root (created by
# scripts/init_db.py). For Postgres, use a URL like
# postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./dev.db

# Signs admin login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Comma-separated browser origins allowed to call the API.
# Defaults to http://localhost:3000,http://127.0.0.1:3000 in development.
# CORS_ALLOWED_ORIGINS=https://hunt.example.com

# Public address of the guest app; encoded in every printed QR code
# ({PUBLIC_BASE_URL}/scan?code=...). Defaults to http://localhost:3000 in
# development. After changing it, re-render QR images with
# python scripts/upload_qr_images.py
# PUBLIC_BASE_URL=https://hunt.example.com

# Optional Supabase Storage for character images and QR codes (public-read
# buckets "character-images" and "qr-codes", see backend/schema.sql).
# Leave both unset to store files on local disk under uploads/.
#
# SUPABASE_URL: Supabase dashboard -> Project Settings -> Data API -> "Project URL"
# SUPABASE_SERVICE_ROLE_KEY: Supabase dashboard -> Project Settings -> API Keys
#   -> "service_role" secret key (NOT the anon/public key: it bypasses RLS and
#   must never be exposed to the frontend or committed to git)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
