DATABASE_URL=postgresql://postgres.your-project-ref:your_password@aws-0-region.pooler.supabase.com:5432/postgres
JWT_SECRET_KEY=<paste the generated value>

# Used by the admin character image-upload endpoint to talk to Supabase
# Storage's REST API directly (bucket: "character-images", must already
# exist and be set to public read access).
#
# SUPABASE_URL: Supabase dashboard -> Project Settings -> Data API -> "Project URL"
#   (looks like https://<your-project-ref>.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY: Supabase dashboard -> Project Settings -> API Keys
#   -> "service_role" secret key (NOT the anon/public key — this one bypasses
#   RLS and must never be exposed to the frontend or committed to git)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<paste the service_role secret key>